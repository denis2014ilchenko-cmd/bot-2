# --- УПРОЩЁННАЯ КОМАНДА /clean (только инструкция) ---
@bot.message_handler(commands=['clean'])
def clean_messages(message):
    try:
        if message.chat.type != 'private':
            bot.reply_to(message, "❌ Эта команда работает только в личном чате с ботом.")
            return
        help_text = (
            "🧹 **Очистка чата**\n\n"
            "Я не могу удалить твои сообщения (ограничение Telegram).\n\n"
            "Но ты можешь очистить всю историю чата со мной вручную:\n"
            "1. Открой этот чат.\n"
            "2. Нажми на три точки (⋮) в правом верхнем углу.\n"
            "3. Выбери **«Очистить историю»**.\n\n"
            "Это удалит **все** сообщения (и твои, и мои) без возможности восстановления."
        )
        bot.reply_to(message, help_text, parse_mode="Markdown")
    except Exception as e:
        print(f"Ошибка в clean: {e}")

